<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x86</PlatformTarget>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <RootNamespace>GymDesk.Fingerprint</RootNamespace>
    <AssemblyName>GymDesk.Fingerprint</AssemblyName>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Evitar que publish/, python/ y respaldos del SDK se arrastren al output -->
    <DefaultItemExcludes>$(DefaultItemExcludes);publish/**;python/**;SDK/_x64_backup/**;bin/**;obj/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
    <!-- Motor de huellas para el lector Hikvision (el SDK de Hikvision solo entrega la imagen) -->
    <PackageReference Include="SourceAFIS" Version="3.14.0" />
    <!-- WMI: letra de unidad y número de serie del lector Hikvision (aparece como CD-ROM USB) -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <!-- Referencia a la DLL manejada de ZKTeco -->
  <ItemGroup>
    <Reference Include="libzkfpcsharp">
      <HintPath>SDK\libzkfpcsharp.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!--
    Runtime nativo de ZKTeco (todo x86) que debe ir junto al exe.
    IMPORTANTE: ZKFPCap.dll carga los modulos de captura desde la subcarpeta
    "ZKFPSensors" que este AL LADO de la propia ZKFPCap.dll; no busca en SysWOW64.
    Sin esa carpeta el SDK nunca enumera el lector (GetDeviceCount = 0) aunque
    Windows lo tenga instalado. Por eso se copian tambien los modulos y sus
    dependencias (libusb0, fpslib, fppswsk12, libiomp5md, zkfinger10-32, ...).
  -->
  <ItemGroup>
    <None Include="SDK\*.dll" Exclude="SDK\libzkfpcsharp.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(Filename)%(Extension)</Link>
    </None>
    <None Include="SDK\ZKFPSensors\*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>ZKFPSensors\%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

</Project>
